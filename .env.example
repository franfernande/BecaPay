# BecaPay · configuración
# Copiá este archivo como .env.local y completalo vos. .env.local nunca se sube a git.
# No compartas nunca la clave privada ni la pegues en chats.

# --- Modo de ejecución -------------------------------------------------------
# true  = simulación: usa cotizaciones reales de Textile pero NO firma ni envía transacciones.
# false = en vivo: firma y envía transacciones reales en Celo mainnet. Cambialo solo cuando apruebes la primera corrida real.
DRY_RUN=true

# --- Celo mainnet (chain id 42220) --------------------------------------------
CELO_RPC_URL=https://forno.celo.org
# Wallet pública del agente (la que firma pagos, cambios y el registro ERC-8004).
AGENT_WALLET_ADDRESS=0xDf0c8840FCc58A7554Bda12ed8A657c74B078C9c
# SECRETO. Clave privada de esa wallet (0x + 64 caracteres hex). Solo hace falta para DRY_RUN=false.
AGENT_PRIVATE_KEY=
# Moneda para pagar el gas: CELO o USDT (abstracción de comisiones de Celo).
GAS_CURRENCY=CELO

# --- Atribución ERC-8021 ------------------------------------------------------
# Tu código de atribución de Celo (solo minúsculas, números y _). Se agrega al calldata de CADA transacción.
# Sin este valor el agente se niega a firmar en vivo.
ATTRIBUTION_TAG=

# --- Identidad ERC-8004 -------------------------------------------------------
# Completalo después de registrar (npm run register:8004 -- --send te muestra el número).
ERC8004_AGENT_ID=
# URL pública de la app (se usa en el archivo de registro del agente).
PUBLIC_APP_URL=http://localhost:4317

# --- Textile (FX / RFQ) -------------------------------------------------------
TEXTILE_API_URL=https://api.textilecredit.com/v2
# Opcional. Clave de partner de Textile; si está vacía, el agente firma la prueba de control EIP-712 con su wallet.
TEXTILE_API_KEY=

# --- Límites de seguridad -----------------------------------------------------
# Máximo de USD₮ que el agente puede cambiar o pagar en un solo ciclo.
MAX_USDT_PER_CYCLE=500
# Desvío máximo aceptado contra el precio de referencia, en puntos básicos (150 = 1,5%).
MAX_SLIPPAGE_BPS=150

# --- Agenda automática ----------------------------------------------------------
# El agente revisa cada N segundos si hay un ciclo vencido o si mañana toca pagar.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Opcional. Si lo completás, POST /api/agent/tick exige "Authorization: Bearer <valor>".
CRON_SECRET=

# --- Acceso al panel ------------------------------------------------------------
# Opcional en tu computadora; OBLIGATORIO antes de publicar la app en internet.
# Protege el panel y todas las acciones con usuario/contraseña. Auditoría y vista de becario siguen públicas.
ADMIN_USER=fundacion
ADMIN_PASSWORD=

# --- Datos locales ----------------------------------------------------------------
# Archivo JSON con programas, becarios y bitácora (por defecto data/becapay.json).
# BECAPAY_DATA_FILE=
